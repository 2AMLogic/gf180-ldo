v {xschem version=3.4.7 file_version=1.2

* drclvs_passives -- symbol for the passive-bearing DRC/LVS flow vehicle
* (issue #313).
*
* Nothing instantiates this cell: it exists only so that xschem netlists
* drclvs_passives.sch as a real `.subckt` with a fixed port order. Without a
* symbol xschem emits the commented `**.subckt` / `*.iopin` form, which is
* not what KLayout's SPICE reader (and therefore the gf180mcu LVS deck)
* consumes.
*
* PORT ORDER -- must match the iopin/ipin order in the schematic, and is what
* the layout's net labels (layout/passives/gen_gds.py) are named after:
*
*     RP  RM  CT  CB  D  G  S  VSS

}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
P 4 5 -60 -80 60 -80 60 80 -60 80 -60 -80 {}
B 5 -62.5 -72.5 -57.5 -67.5 {name=RP dir=inout}
L 7 -80 -70 -60 -70 {}
T {RP} -55 -74 0 0 0.2 0.2 {}
B 5 -62.5 -52.5 -57.5 -47.5 {name=RM dir=inout}
L 7 -80 -50 -60 -50 {}
T {RM} -55 -54 0 0 0.2 0.2 {}
B 5 -62.5 -32.5 -57.5 -27.5 {name=CT dir=inout}
L 7 -80 -30 -60 -30 {}
T {CT} -55 -34 0 0 0.2 0.2 {}
B 5 -62.5 -12.5 -57.5 -7.5 {name=CB dir=inout}
L 7 -80 -10 -60 -10 {}
T {CB} -55 -14 0 0 0.2 0.2 {}
B 5 57.5 -72.5 62.5 -67.5 {name=D dir=inout}
L 7 60 -70 80 -70 {}
T {D} 55 -74 0 1 0.2 0.2 {}
B 5 -62.5 7.5 -57.5 12.5 {name=G dir=in}
L 7 -80 10 -60 10 {}
T {G} -55 6 0 0 0.2 0.2 {}
B 5 57.5 -52.5 62.5 -47.5 {name=S dir=inout}
L 7 60 -50 80 -50 {}
T {S} 55 -54 0 1 0.2 0.2 {}
B 5 -62.5 67.5 -57.5 72.5 {name=VSS dir=inout}
L 7 -80 70 -60 70 {}
T {VSS} -55 66 0 0 0.2 0.2 {}
T {@symname} -50 -6 0 0 0.3 0.3 {}
T {@name} -60 -92 0 0 0.2 0.2 {}
