*.raw
*.log
__pycache__/
.DS_Store

# sim/<slug>/corners/**/*.log are force-added despite the blanket *.log
# ignore above -- they are append-only evidence per CLAUDE.md and the
# sim/README.md record format (issue #5), not scratch logs. Mirrors
# gf180-bandgap's sim/smoke_test/smoke_test.log precedent.
!sim/*/corners/**/*.log

# Scratch directory for sim/devchar: the drivers write each substituted deck and
# its ngspice log here before deleting them (DC_KEEP=1 retains them). Generated
# artefacts, never evidence -- the evidence is the CSV rows the decks emit.
sim/devchar/.build/

# Simulation harness scratch: generated ngspice decks. Disposable; the
# evidence that is meant to survive lives in sim/<experiment-slug>/.
sim/.work/

# Machine-local PDK override (sim/pdk.json is the committed default).
sim/pdk.local.json

# DRC/LVS run scratch: the generated GDS, the assembled rule deck, and
# KLayout's own .lyrdb / .lvsdb databases and logs. All regenerable and
# machine-specific; the evidence that survives is layout/records/.
layout/.work/
