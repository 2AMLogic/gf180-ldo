let vsd1 = v(vin) - vd1
let id1 = 0.05
let rds1 = vsd1 / id1
let rw1 = rds1 * 1
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,1,drop_at_50mA,$&vsd1,$&id1,$&rds1,$&rw1,$&vd1" >> @OUT@
