let rw25 = rds25 * 4
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L3@,4,id_at_drop100mV,0.1,0.1,$&id25,$&rds25,$&rw25" >> @OUT@
let id26 = i(v26)
