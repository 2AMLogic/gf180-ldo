echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L2@,1,id_at_drop100mV,0.1,0.1,$&id10,$&rds10,$&rw10" >> @OUT@
let id11 = i(v11)
let rds11 = 0.2 / id11
let rw11 = rds11 * 1
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L2@,1,id_at_drop200mV,0.2,0.2,$&id11,$&rds11,$&rw11" >> @OUT@
