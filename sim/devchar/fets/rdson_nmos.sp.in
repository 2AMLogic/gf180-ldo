let rw8 = rds8 * 4
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,4,id_at_drop200mV,0.2,0.2,$&id8,$&rds8,$&rw8" >> @OUT@
let id9 = i(v9)
let rds9 = 0.3 / id9
let rw9 = rds9 * 4
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,4,id_at_drop300mV,0.3,0.3,$&id9,$&rds9,$&rw9" >> @OUT@
