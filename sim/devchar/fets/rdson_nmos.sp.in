* gf180mcu NMOS pass-device (source-follower) headroom characterization
* Issue #4 - template; fets/run.sh substitutes @TOKENS@ and runs the deck.
*
* Topology: drain at Vin, bulk at 0 V (p-substrate, so body effect is included),
* source = regulator output held at Vin - drop by an ideal source, drain current
* measured. Gate is at Vin for the realistic (no charge pump) rows, since a
* ground-referenced error amp cannot drive the gate above the supply; the
* vgboost rows raise the gate above Vin to quantify what a charge pump must
* deliver for the same load current.
* Note Vgs = drop for the unboosted rows (gate at Vin, source at Vin-drop).
* Unit cell is w=100u / nf=10 (10 um per finger); total W = 100u * m.
*
.include @MODELS@/design.ngspice
.lib @MODELS@/sm141064.ngspice @CORNER@
.options temp=@TEMP@
.param vin=@VIN@

vin vin 0 dc 'vin'
vg  g   0 dc 'vin'
vgb0p5 gb0p5 0 dc 'vin+0.5'
vgb1p0 gb1p0 0 dc 'vin+1.0'
vgb1p5 gb1p5 0 dc 'vin+1.5'
vgb2p0 gb2p0 0 dc 'vin+2.0'

x1 vin g s1 0 @DEV@ w=100u l=@L1@ nf=10 m=10
v1 s1 0 dc 'vin-0.1'
x2 vin g s2 0 @DEV@ w=100u l=@L1@ nf=10 m=10
v2 s2 0 dc 'vin-0.2'
x3 vin g s3 0 @DEV@ w=100u l=@L1@ nf=10 m=10
v3 s3 0 dc 'vin-0.3'
x4 vin g s4 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v4 s4 0 dc 'vin-0.1'
x5 vin g s5 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v5 s5 0 dc 'vin-0.2'
x6 vin g s6 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v6 s6 0 dc 'vin-0.3'
x7 vin g s7 0 @DEV@ w=100u l=@L1@ nf=10 m=40
v7 s7 0 dc 'vin-0.1'
x8 vin g s8 0 @DEV@ w=100u l=@L1@ nf=10 m=40
v8 s8 0 dc 'vin-0.2'
x9 vin g s9 0 @DEV@ w=100u l=@L1@ nf=10 m=40
v9 s9 0 dc 'vin-0.3'

x10 vin g s10 0 @DEV@ w=100u l=@L2@ nf=10 m=10
v10 s10 0 dc 'vin-0.1'
x11 vin g s11 0 @DEV@ w=100u l=@L2@ nf=10 m=10
v11 s11 0 dc 'vin-0.2'
x12 vin g s12 0 @DEV@ w=100u l=@L2@ nf=10 m=10
v12 s12 0 dc 'vin-0.3'
x13 vin g s13 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v13 s13 0 dc 'vin-0.1'
x14 vin g s14 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v14 s14 0 dc 'vin-0.2'
x15 vin g s15 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v15 s15 0 dc 'vin-0.3'
x16 vin g s16 0 @DEV@ w=100u l=@L2@ nf=10 m=40
v16 s16 0 dc 'vin-0.1'
x17 vin g s17 0 @DEV@ w=100u l=@L2@ nf=10 m=40
v17 s17 0 dc 'vin-0.2'
x18 vin g s18 0 @DEV@ w=100u l=@L2@ nf=10 m=40
v18 s18 0 dc 'vin-0.3'

x19 vin g s19 0 @DEV@ w=100u l=@L3@ nf=10 m=10
v19 s19 0 dc 'vin-0.1'
x20 vin g s20 0 @DEV@ w=100u l=@L3@ nf=10 m=10
v20 s20 0 dc 'vin-0.2'
x21 vin g s21 0 @DEV@ w=100u l=@L3@ nf=10 m=10
v21 s21 0 dc 'vin-0.3'
x22 vin g s22 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v22 s22 0 dc 'vin-0.1'
x23 vin g s23 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v23 s23 0 dc 'vin-0.2'
x24 vin g s24 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v24 s24 0 dc 'vin-0.3'
x25 vin g s25 0 @DEV@ w=100u l=@L3@ nf=10 m=40
v25 s25 0 dc 'vin-0.1'
x26 vin g s26 0 @DEV@ w=100u l=@L3@ nf=10 m=40
v26 s26 0 dc 'vin-0.2'
x27 vin g s27 0 @DEV@ w=100u l=@L3@ nf=10 m=40
v27 s27 0 dc 'vin-0.3'

x28 vin gb0p5 s28 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v28 s28 0 dc 'vin-0.3'
x29 vin gb1p0 s29 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v29 s29 0 dc 'vin-0.3'
x30 vin gb1p5 s30 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v30 s30 0 dc 'vin-0.3'
x31 vin gb2p0 s31 0 @DEV@ w=100u l=@L1@ nf=10 m=20
v31 s31 0 dc 'vin-0.3'
x32 vin gb0p5 s32 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v32 s32 0 dc 'vin-0.3'
x33 vin gb1p0 s33 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v33 s33 0 dc 'vin-0.3'
x34 vin gb1p5 s34 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v34 s34 0 dc 'vin-0.3'
x35 vin gb2p0 s35 0 @DEV@ w=100u l=@L2@ nf=10 m=20
v35 s35 0 dc 'vin-0.3'
x36 vin gb0p5 s36 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v36 s36 0 dc 'vin-0.3'
x37 vin gb1p0 s37 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v37 s37 0 dc 'vin-0.3'
x38 vin gb1p5 s38 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v38 s38 0 dc 'vin-0.3'
x39 vin gb2p0 s39 0 @DEV@ w=100u l=@L3@ nf=10 m=20
v39 s39 0 dc 'vin-0.3'

.control
op
let id1 = i(v1)
let rds1 = 0.1 / id1
let rw1 = rds1 * 1
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,1,id_at_drop100mV,0.1,0.1,$&id1,$&rds1,$&rw1" >> @OUT@
let id2 = i(v2)
let rds2 = 0.2 / id2
let rw2 = rds2 * 1
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,1,id_at_drop200mV,0.2,0.2,$&id2,$&rds2,$&rw2" >> @OUT@
let id3 = i(v3)
let rds3 = 0.3 / id3
let rw3 = rds3 * 1
echo "@DEV@,@CORNER@,@TEMP@,@VIN@,@L1@,1,id_at_drop300mV,0.3,0.3,$&id3,$&rds3,$&rw3" >> @OUT@
