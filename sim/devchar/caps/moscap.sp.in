* gf180mcu MOS capacitor menu: capacitance vs bias (including the low-bias
* depletion region), area scaling and corner spread
* Density columns are emitted directly in fF/um^2 (C/area).
* Issue #4 - template; caps/run.sh substitutes @TOKENS@ and runs the deck.
*
* Each capacitor is driven by its own source carrying both the DC bias and a 1 V
* AC excitation, so C = |Im{I}| / (2*pi*f). The MOSCAP cards are behavioural
* capacitors of the form
*     C = corner * L * W * (cvar1 + cvar2*tanh(cvar3*V(1,2) + cvar4))
* so the bias sweep is the whole point: the tanh collapses the capacitance by
* roughly two orders of magnitude once the device leaves inversion. The driver
* steps @VBIAS@ across the full +/- supply range so the depletion knee is
* recorded, not just the inversion plateau.
* Inversion-mode (cap_*_03v3 / cap_*_06v0) and well-mode (cap_*_03v3_b) devices
* are both carried because their useful bias polarity is opposite.
*
.include @MODELS@/design.ngspice
.lib @MODELS@/sm141064.ngspice @MOSCAPLIB@
.options temp=@TEMP@
.param vb=@VBIAS@

v1 p1 0 dc 'vb' ac 1
x1 p1 0 cap_nmos_03v3 c_width=10u c_length=10u
v2 p2 0 dc 'vb' ac 1
x2 p2 0 cap_nmos_03v3 c_width=30u c_length=30u
v3 p3 0 dc 'vb' ac 1
x3 p3 0 cap_pmos_03v3 c_width=10u c_length=10u
v4 p4 0 dc 'vb' ac 1
x4 p4 0 cap_pmos_03v3 c_width=30u c_length=30u
v5 p5 0 dc 'vb' ac 1
x5 p5 0 cap_nmos_03v3_b c_width=10u c_length=10u
v6 p6 0 dc 'vb' ac 1
x6 p6 0 cap_nmos_03v3_b c_width=30u c_length=30u
v7 p7 0 dc 'vb' ac 1
x7 p7 0 cap_pmos_03v3_b c_width=10u c_length=10u
v8 p8 0 dc 'vb' ac 1
x8 p8 0 cap_pmos_03v3_b c_width=30u c_length=30u
v9 p9 0 dc 'vb' ac 1
x9 p9 0 cap_nmos_06v0 c_width=10u c_length=10u
v10 p10 0 dc 'vb' ac 1
x10 p10 0 cap_nmos_06v0 c_width=30u c_length=30u
v11 p11 0 dc 'vb' ac 1
x11 p11 0 cap_pmos_06v0 c_width=10u c_length=10u
v12 p12 0 dc 'vb' ac 1
x12 p12 0 cap_pmos_06v0 c_width=30u c_length=30u

.control
ac lin 1 1k 1k
let c1 = abs(imag(i(v1))) / (2*pi*1k)
let d1 = c1 / 100e-15
echo "cap_nmos_03v3,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c1,$&d1" >> @OUT@
let c2 = abs(imag(i(v2))) / (2*pi*1k)
let d2 = c2 / 900e-15
echo "cap_nmos_03v3,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c2,$&d2" >> @OUT@
let c3 = abs(imag(i(v3))) / (2*pi*1k)
let d3 = c3 / 100e-15
echo "cap_pmos_03v3,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c3,$&d3" >> @OUT@
let c4 = abs(imag(i(v4))) / (2*pi*1k)
let d4 = c4 / 900e-15
echo "cap_pmos_03v3,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c4,$&d4" >> @OUT@
let c5 = abs(imag(i(v5))) / (2*pi*1k)
let d5 = c5 / 100e-15
echo "cap_nmos_03v3_b,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c5,$&d5" >> @OUT@
let c6 = abs(imag(i(v6))) / (2*pi*1k)
let d6 = c6 / 900e-15
echo "cap_nmos_03v3_b,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c6,$&d6" >> @OUT@
let c7 = abs(imag(i(v7))) / (2*pi*1k)
let d7 = c7 / 100e-15
echo "cap_pmos_03v3_b,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c7,$&d7" >> @OUT@
let c8 = abs(imag(i(v8))) / (2*pi*1k)
let d8 = c8 / 900e-15
echo "cap_pmos_03v3_b,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c8,$&d8" >> @OUT@
let c9 = abs(imag(i(v9))) / (2*pi*1k)
let d9 = c9 / 100e-15
echo "cap_nmos_06v0,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c9,$&d9" >> @OUT@
let c10 = abs(imag(i(v10))) / (2*pi*1k)
let d10 = c10 / 900e-15
echo "cap_nmos_06v0,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c10,$&d10" >> @OUT@
let c11 = abs(imag(i(v11))) / (2*pi*1k)
let d11 = c11 / 100e-15
echo "cap_pmos_06v0,@MOSCAPLIB@,@TEMP@,@VBIAS@,10,10,100,$&c11,$&d11" >> @OUT@
let c12 = abs(imag(i(v12))) / (2*pi*1k)
let d12 = c12 / 900e-15
echo "cap_pmos_06v0,@MOSCAPLIB@,@TEMP@,@VBIAS@,30,30,900,$&c12,$&d12" >> @OUT@
quit
.endc
.end
