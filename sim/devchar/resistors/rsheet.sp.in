x29 n29 0 0 ppolyf_s r_width=5u r_length=50u
i29 0 n29 dc 1u
x30 n30 0 0 ppolyf_s r_width=1u r_length=50u
i30 0 n30 dc 50u

x31 n31 0 0 nplus_u r_width=1u r_length=10u
i31 0 n31 dc 1u
x32 n32 0 0 nplus_u r_width=1u r_length=50u
i32 0 n32 dc 1u
