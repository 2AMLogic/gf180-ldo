i36 0 n36 dc 1u
x37 n37 0 vnw pplus_u r_width=1u r_length=50u
i37 0 n37 dc 1u
x38 n38 0 vnw pplus_u r_width=2u r_length=20u
i38 0 n38 dc 1u
x39 n39 0 vnw pplus_u r_width=5u r_length=50u
i39 0 n39 dc 1u
x40 n40 0 vnw pplus_u r_width=1u r_length=50u
i40 0 n40 dc 50u

x41 n41 0 0 nwell r_width=1u r_length=10u
i41 0 n41 dc 1u
x42 n42 0 0 nwell r_width=1u r_length=50u
i42 0 n42 dc 1u
x43 n43 0 0 nwell r_width=2u r_length=20u
i43 0 n43 dc 1u
x44 n44 0 0 nwell r_width=5u r_length=50u
i44 0 n44 dc 1u
x45 n45 0 0 nwell r_width=1u r_length=50u
i45 0 n45 dc 50u

.control
op
let r1 = v(n1) / 1e-6
echo "ppolyf_u_1k,@RESLIB@,@TEMP@,1,10,1u,$&r1,1000" >> @OUT@
