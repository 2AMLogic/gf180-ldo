i13 0 n13 dc 1u
x14 n14 0 0 ppolyf_u_3k r_width=5u r_length=50u
i14 0 n14 dc 1u
x15 n15 0 0 ppolyf_u_3k r_width=1u r_length=50u
i15 0 n15 dc 50u

x16 n16 0 0 ppolyf_u r_width=1u r_length=10u
i16 0 n16 dc 1u
x17 n17 0 0 ppolyf_u r_width=1u r_length=50u
i17 0 n17 dc 1u
x18 n18 0 0 ppolyf_u r_width=2u r_length=20u
i18 0 n18 dc 1u
x19 n19 0 0 ppolyf_u r_width=5u r_length=50u
i19 0 n19 dc 1u
x20 n20 0 0 ppolyf_u r_width=1u r_length=50u
i20 0 n20 dc 50u

x21 n21 0 0 npolyf_u r_width=1u r_length=10u
i21 0 n21 dc 1u
x22 n22 0 0 npolyf_u r_width=1u r_length=50u
i22 0 n22 dc 1u
