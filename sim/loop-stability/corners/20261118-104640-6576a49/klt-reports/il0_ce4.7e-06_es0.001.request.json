{
  "netlist": "body.spice",
  "engine": "ngspice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "res_ff",
        "sections": [
          "typical",
          "res_ff",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "res_ss",
        "sections": [
          "typical",
          "res_ss",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "params": {
      "vsup": [
        2.97,
        3.3,
        3.63
      ]
    },
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ]
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 400 0.01 1e9",
    "passes": [
      {
        "name": "inj_v",
        "alter": [
          {
            "target": "Vinj",
            "value": 1
          },
          {
            "target": "Iinj",
            "value": 0
          }
        ]
      },
      {
        "name": "inj_i",
        "alter": [
          {
            "target": "Vinj",
            "value": 0
          },
          {
            "target": "Iinj",
            "value": 1
          }
        ]
      }
    ]
  },
  "measurements": [
    {
      "name": "vout_v",
      "expr": "v(vout)"
    },
    {
      "name": "dcgain_db",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "low_frequency_gain_db"
      }
    },
    {
      "name": "f0_hz",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "unity_crossing_hz"
      }
    },
    {
      "name": "phase_at_f0_deg",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "phase_at_unity_deg"
      }
    },
    {
      "name": "f180_hz",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "phase_crossover_hz"
      }
    },
    {
      "name": "gain_at_f180_db",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "gain_margin_db"
      }
    },
    {
      "name": "f0_rising_hz",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "rising_unity_crossing_hz"
      }
    },
    {
      "name": "resurgence_db",
      "tian": {
        "voltage_pass": "inj_v",
        "current_pass": "inj_i",
        "series_injection": {
          "load_node": "binj",
          "source": "vinj"
        },
        "metric": "peak_above_crossover_db",
        "from_ratio": 1.05
      }
    }
  ],
  "batch": {
    "max_units_per_job": 3,
    "max_concurrent_jobs": 3,
    "capacity_wait_s": 600
  },
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true,
    "stage_model_inputs": true
  }
}
